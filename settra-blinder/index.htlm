</nav>

<!-- HERO -->
<div class="hero">
  <div class="hero-eyebrow">Malware Intelligence Report</div>
  <h1><span>Settra Blinder</span><br>IOCs &amp; Detection</h1>
  <p class="hero-lead">
    Indicators of compromise, technical analysis, YARA detection rule, and mitigation guidance for Settra Blinder — a 64-bit Windows EDR evasion toolkit exploiting vulnerable kernel drivers to blind endpoint defences.
  </p>
  <div class="hero-meta">
    <div class="meta-item">
      <span class="meta-label">Published</span>
      <span class="meta-val">July 2026</span>
    </div>
