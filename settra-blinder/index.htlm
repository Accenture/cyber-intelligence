<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Settra Blinder — IOCs & Detection | Accenture Apex Labs</title>
<style>
  :root {
    --bg: #0a0c10;
    --surface: #111318;
    --surface2: #1a1d26;
    --border: #262b38;
    --accent: #e8473f;
    --accent2: #ff6b35;
    --text: #e4e6ed;
    --muted: #7a8099;
    --code-bg: #0d1117;
    --code-border: #1e2534;
    --green: #3fb950;
    --yellow: #d29922;
    --font-mono: 'JetBrains Mono', 'Fira Code', 'Cascadia Code', ui-monospace, monospace;
    --font-sans: 'Inter', system-ui, -apple-system, sans-serif;
    --nav-h: 60px;
  }

  *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

  html { scroll-behavior: smooth; }

  body {
    background: var(--bg);
    color: var(--text);
    font-family: var(--font-sans);
    font-size: 15px;
    line-height: 1.65;
    -webkit-font-smoothing: antialiased;
  }

  /* ─── NAV ─────────────────────────────────────────── */
  nav {
    position: fixed;
    top: 0; left: 0; right: 0;
    height: var(--nav-h);
    background: rgba(10,12,16,0.92);
    backdrop-filter: blur(12px);
    border-bottom: 1px solid var(--border);
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0 2rem;
    z-index: 100;
  }

  .nav-brand {
    display: flex;
    align-items: center;
    gap: 10px;
    font-size: 13px;
    font-weight: 600;
    letter-spacing: .04em;
    text-transform: uppercase;
    color: var(--text);
    text-decoration: none;
  }

  .nav-brand .dot {
    width: 8px; height: 8px;
    border-radius: 50%;
    background: var(--accent);
    box-shadow: 0 0 8px var(--accent);
    animation: pulse 2.4s ease-in-out infinite;
  }

  @keyframes pulse {
    0%, 100% { opacity: 1; }
    50% { opacity: 0.35; }
  }

  .nav-links {
    display: flex;
    gap: 0;
    list-style: none;
  }

  .nav-links a {
    display: block;
    padding: .4rem 1rem;
    font-size: 12.5px;
    font-weight: 500;
    letter-spacing: .03em;
    text-transform: uppercase;
    color: var(--muted);
    text-decoration: none;
    border-radius: 4px;
    transition: color .2s;
  }

  .nav-links a:hover { color: var(--text); }

  .nav-tag {
    font-size: 11px;
    font-family: var(--font-mono);
    font-weight: 600;
    letter-spacing: .06em;
    color: var(--accent);
    background: rgba(232,71,63,.12);
    border: 1px solid rgba(232,71,63,.3);
    border-radius: 4px;
    padding: 3px 8px;
  }

  /* ─── HERO ────────────────────────────────────────── */
  .hero {
    padding-top: calc(var(--nav-h) + 80px);
    padding-bottom: 80px;
    padding-left: 2rem;
    padding-right: 2rem;
    max-width: 900px;
    margin: 0 auto;
  }

  .hero-eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-size: 11.5px;
    font-family: var(--font-mono);
    font-weight: 600;
    letter-spacing: .1em;
    text-transform: uppercase;
    color: var(--accent);
    margin-bottom: 1.5rem;
  }

  .hero-eyebrow::before {
    content: '';
    display: block;
    width: 28px; height: 1px;
    background: var(--accent);
  }

  h1 {
    font-size: clamp(2.2rem, 5vw, 3.6rem);
    font-weight: 800;
    letter-spacing: -.02em;
    line-height: 1.1;
    margin-bottom: 1.25rem;
    color: #fff;
  }

  h1 span { color: var(--accent); }

  .hero-lead {
    font-size: 17px;
    color: var(--muted);
    max-width: 680px;
    margin-bottom: 2.5rem;
  }

  .hero-meta {
    display: flex;
    gap: 2rem;
    flex-wrap: wrap;
  }

  .meta-item {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  .meta-label {
    font-size: 10.5px;
    font-family: var(--font-mono);
    letter-spacing: .08em;
    text-transform: uppercase;
    color: var(--muted);
  }

  .meta-val {
    font-size: 13.5px;
    font-weight: 600;
    color: var(--text);
  }

  .hero-divider {
    width: 100%;
    height: 1px;
    background: linear-gradient(90deg, var(--border), transparent);
    margin: 3rem 0 0;
  }

  /* ─── MAIN LAYOUT ─────────────────────────────────── */
  .layout {
    max-width: 1100px;
    margin: 0 auto;
    padding: 0 2rem 6rem;
    display: grid;
    grid-template-columns: 220px 1fr;
    gap: 3rem;
    align-items: start;
  }

  /* ─── SIDEBAR ─────────────────────────────────────── */
  .sidebar {
    position: sticky;
    top: calc(var(--nav-h) + 1.5rem);
  }

  .sidebar-section { margin-bottom: 2rem; }

  .sidebar-label {
    font-size: 10px;
    font-family: var(--font-mono);
    letter-spacing: .12em;
    text-transform: uppercase;
    color: var(--muted);
    margin-bottom: .6rem;
    padding-left: .75rem;
    border-left: 2px solid var(--border);
  }

  .sidebar-nav { list-style: none; }

  .sidebar-nav li a {
    display: block;
    padding: .3rem .75rem;
    font-size: 13px;
    color: var(--muted);
    text-decoration: none;
    border-left: 2px solid var(--border);
    transition: color .15s, border-color .15s;
  }

  .sidebar-nav li a:hover,
  .sidebar-nav li a.active {
    color: var(--text);
    border-left-color: var(--accent);
  }

  /* ─── CONTENT ─────────────────────────────────────── */
  .content section { margin-bottom: 4.5rem; }

  .section-header {
    display: flex;
    align-items: center;
    gap: 1rem;
    margin-bottom: 1.5rem;
    padding-bottom: 1rem;
    border-bottom: 1px solid var(--border);
  }

  .section-number {
    font-size: 11px;
    font-family: var(--font-mono);
    font-weight: 700;
    color: var(--accent);
    background: rgba(232,71,63,.1);
    border: 1px solid rgba(232,71,63,.2);
    border-radius: 4px;
    padding: 2px 7px;
    flex-shrink: 0;
  }

  h2 {
    font-size: 1.35rem;
    font-weight: 700;
    color: #fff;
    letter-spacing: -.01em;
  }

  h3 {
    font-size: 1rem;
    font-weight: 700;
    color: var(--text);
    margin: 1.8rem 0 .7rem;
    letter-spacing: .005em;
  }

  p { color: var(--muted); margin-bottom: 1rem; }

  /* ─── SAMPLE TABLE ────────────────────────────────── */
  .table-wrap {
    overflow-x: auto;
    border: 1px solid var(--border);
    border-radius: 8px;
    margin-bottom: 1.5rem;
  }

  table {
    width: 100%;
    border-collapse: collapse;
    font-size: 12.5px;
  }

  thead tr { background: var(--surface2); }

  thead th {
    padding: .65rem 1rem;
    text-align: left;
    font-size: 10.5px;
    font-family: var(--font-mono);
    font-weight: 700;
    letter-spacing: .08em;
    text-transform: uppercase;
    color: var(--muted);
    white-space: nowrap;
    border-bottom: 1px solid var(--border);
  }

  tbody tr {
    border-bottom: 1px solid var(--border);
    transition: background .12s;
  }

  tbody tr:last-child { border-bottom: none; }
  tbody tr:hover { background: var(--surface); }

  tbody td {
    padding: .6rem 1rem;
    vertical-align: middle;
  }

  td.hash {
    font-family: var(--font-mono);
    font-size: 11.5px;
    color: #a8b5d4;
    word-break: break-all;
  }

  td.label {
    font-family: var(--font-mono);
    font-size: 12px;
    color: var(--muted);
    white-space: nowrap;
    font-weight: 600;
  }

  td.val {
    font-family: var(--font-mono);
    font-size: 12px;
    color: var(--text);
    word-break: break-all;
  }

  .tag {
    display: inline-block;
    font-size: 10.5px;
    font-family: var(--font-mono);
    font-weight: 600;
    padding: 2px 7px;
    border-radius: 3px;
    white-space: nowrap;
  }

  .tag-all    { background: rgba(59,130,246,.12); color: #60a5fa; border: 1px solid rgba(59,130,246,.25); }
  .tag-na     { background: rgba(100,116,139,.12); color: #94a3b8; border: 1px solid rgba(100,116,139,.25); }

  /* ─── MITIGATION LIST ─────────────────────────────── */
  .mitigation-list {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: .75rem;
  }

  .mitigation-list li {
    display: flex;
    gap: 1rem;
    padding: .9rem 1.1rem;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 6px;
    font-size: 13.5px;
    color: var(--muted);
    line-height: 1.5;
    transition: border-color .15s;
  }

  .mitigation-list li:hover { border-color: rgba(232,71,63,.35); }

  .mitigation-list li::before {
    content: '›';
    color: var(--accent);
    font-size: 1rem;
    font-weight: 700;
    flex-shrink: 0;
    margin-top: 1px;
  }

  /* ─── CODE BLOCKS ─────────────────────────────────── */
  .yara-block {
    background: var(--code-bg);
    border: 1px solid var(--code-border);
    border-radius: 8px;
    margin-bottom: 1.75rem;
    overflow: hidden;
  }

  .yara-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: .55rem 1rem;
    background: #0a0f1a;
    border-bottom: 1px solid var(--code-border);
  }

  .yara-name {
    font-family: var(--font-mono);
    font-size: 11.5px;
    font-weight: 700;
    color: var(--green);
    letter-spacing: .04em;
  }

  .yara-meta-tags { display: flex; gap: .5rem; }

  .yara-meta-tag {
    font-size: 10px;
    font-family: var(--font-mono);
    color: var(--muted);
    background: var(--surface2);
    border: 1px solid var(--border);
    border-radius: 3px;
    padding: 1px 6px;
  }

  pre {
    overflow-x: auto;
    padding: 1.25rem 1.25rem;
  }

  code {
    font-family: var(--font-mono);
    font-size: 12px;
    line-height: 1.75;
    color: #cdd9f5;
    white-space: pre;
  }

  .kw  { color: #ff7b72; }
  .st  { color: #a5d6ff; }
  .cm  { color: #5a6a8a; font-style: italic; }
  .fn  { color: #d2a8ff; }
  .hex { color: #79c0ff; }
  .nm  { color: #ffa657; }

  /* ─── CALLOUT ─────────────────────────────────────── */
  .callout {
    background: var(--surface);
    border: 1px solid var(--border);
    border-left: 3px solid var(--accent);
    border-radius: 0 6px 6px 0;
    padding: .9rem 1.1rem;
    margin-bottom: 1.5rem;
    font-size: 13.5px;
    color: var(--muted);
    line-height: 1.6;
  }

  .callout strong { color: var(--text); }

  /* ─── FOOTER ──────────────────────────────────────── */
  footer {
    border-top: 1px solid var(--border);
    padding: 2rem;
    text-align: center;
    font-size: 12px;
    color: var(--muted);
    font-family: var(--font-mono);
  }

  footer span { color: var(--accent); }

  /* ─── RESPONSIVE ──────────────────────────────────── */
  @media (max-width: 768px) {
    .layout { grid-template-columns: 1fr; }
    .sidebar { display: none; }
    .nav-links { display: none; }
    h1 { font-size: 2rem; }
  }
</style>
</head>
